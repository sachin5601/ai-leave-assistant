    {
      "parameters": {
        "jsCode": "const employeeId = $('Webhook').first().json.body.employeeId;\n\nconst requests = $input.all();\n\nconst history = requests\n  .filter(item => {\n    return String(item.json['Employee ID']).trim() === String(employeeId).trim();\n  })\n  .map(item => ({\n    requestId: item.json['Request ID'],\n    leaveType: item.json['Leave Type'],\n    startDate: item.json['Start Date'],\n    endDate: item.json['End Date'],\n    reason: item.json['Reason'],\n    status: item.json['Status'],\n    manager: item.json['Manager']\n  }));\n\nreturn [\n  {\n    json: {\n      success: true,\n      employeeId: employeeId,\n      history: history\n    }\n  }\n];"
      },
