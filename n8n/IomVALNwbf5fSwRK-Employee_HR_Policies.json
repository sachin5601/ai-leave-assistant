    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst policies = [];\nconst seen = new Set();\n\nfor (const [index, item] of items.entries()) {\n  const data = item.json;\n  const document = data.document ?? data;\n\n  const content = String(\n    document.pageContent ??\n    document.content ??\n    data.pageContent ??\n    data.content ??\n    ''\n  ).trim();\n\n  if (!content) continue;\n\n  const metadata = document.metadata ?? data.metadata ?? {};\n\n  const key = content.toLowerCase().replace(/\\s+/g, ' ');\n  if (seen.has(key)) continue;\n  seen.add(key);\n\n  let title =\n    metadata.title ??\n    metadata.section ??\n    `HR Leave Policy - Section ${index + 1}`;\n\n  // If the content itself contains numbered sections,\n  // use the first section heading as the title.\n  const heading = content.match(/^(\\d+)\\.\\s+([^•]+?)(?=\\s+•|\\s*$)/);\n\n  if (heading) {\n    title = heading[2].trim();\n  }\n\n  policies.push({\n    id: String(metadata.id ?? index + 1),\n    title,\n    content\n  });\n}\n\nreturn [\n  {\n    json: {\n      success: true,\n      policies\n    }\n  }\n];"
      },
