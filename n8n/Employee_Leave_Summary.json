    {
      "parameters": {
        "jsCode": "const employee = $('Employee Data').first().json;\nconst requests = $('Leave Requests').all();\n\nconst totalLeave = Number(employee['Leave Balance']) || 0;\nconst sickLeave = Number(employee['Sick Leave']) || 0;\nconst casualLeave = Number(employee['Casual Leave']) || 0;\n\nlet usedLeave = 0;\n\nfor (const item of requests) {\n  const request = item.json;\n\n  const sameEmployee =\n    String(request['Employee ID']).trim() ===\n    String(employee['Employee ID']).trim();\n\n  const approved =\n    String(request['Status']).trim().toLowerCase() === 'approved';\n\n  if (sameEmployee && approved) {\n    const start = new Date(request['Start Date']);\n    const end = new Date(request['End Date']);\n\n    if (!isNaN(start.getTime()) && !isNaN(end.getTime())) {\n      const days =\n        Math.floor(\n          (end.getTime() - start.getTime()) /\n            (1000 * 60 * 60 * 24)\n        ) + 1;\n\n      if (days > 0) {\n        usedLeave += days;\n      }\n    }\n  }\n}\n\nconst remainingLeave = Math.max(\n  totalLeave - usedLeave,\n  0\n);\n\nreturn [\n  {\n    json: {\n      success: true,\n      employeeId: employee['Employee ID'],\n      name: employee['Name'],\n      totalLeaveBalance: totalLeave,\n      sickLeave: sickLeave,\n      casualLeave: casualLeave,\n      usedLeave: usedLeave,\n      remainingLeave: remainingLeave\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
      "id": "bf70121a-403d-4dcb-8dab-07d067940f72",
      "name": "Code in JavaScript"
