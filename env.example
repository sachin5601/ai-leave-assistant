# =========================================================
# AI Leave Assistant - Environment Configuration
# =========================================================

# Application
VITE_DEMO_MODE=false
VITE_API_TIMEOUT_MS=30000


# =========================================================
# n8n Webhook Endpoints
# =========================================================
#
# Create the corresponding workflows in your n8n instance.
# Activate each workflow and copy its Production Webhook URL.
#
# Expected URL structure:
# https://YOUR-N8N-DOMAIN/webhook/YOUR-WEBHOOK-PATH
#
# Replace the placeholder URLs below with your own endpoints.
# =========================================================

# Authentication
VITE_N8N_AUTH_URL=https://YOUR-N8N-DOMAIN/webhook/your-auth-webhook

# AI Chat Assistant
VITE_N8N_CHAT_URL=https://YOUR-N8N-DOMAIN/webhook/your-chat-webhook

# Employee Profile
VITE_N8N_PROFILE_URL=https://YOUR-N8N-DOMAIN/webhook/your-profile-webhook

# Leave Summary / Balance
VITE_N8N_LEAVE_SUMMARY_URL=https://YOUR-N8N-DOMAIN/webhook/your-leave-summary-webhook

# Leave History
VITE_N8N_LEAVE_HISTORY_URL=https://YOUR-N8N-DOMAIN/webhook/your-leave-history-webhook

# Session Validation
VITE_N8N_SESSION_VALIDATE_URL=https://YOUR-N8N-DOMAIN/webhook/your-session-validation-webhook

# Leave Policy
VITE_N8N_POLICY_URL=https://YOUR-N8N-DOMAIN/webhook/your-policy-webhook
